# Copy these values into your shell environment before starting Spring Boot.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/sp_computers?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CATALOG_DEMO_SEED=true
# Demo profile: uses an in-memory H2 database and seeds sample products.
SPRING_PROFILES_ACTIVE=demo
